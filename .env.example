GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.8-flash
DATABASE_PATH=data/mineguard.db
COOKIE_SECURE=false
AI_ENABLED=true
# Set true only behind HTTPS in deployment.
# No shared/default passwords. Run python setup_local.py.
# Optional: create the first administrator only when the database has no users.
# Set the password in the hosting provider's secret manager; never commit it.
# INITIAL_ADMIN_USERNAME=admin
# INITIAL_ADMIN_PASSWORD=
